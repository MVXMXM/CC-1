# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required for GPT / emoji features
OPENAI_API_KEY=

# Optional — only if you use the Claude option in the app settings
ANTHROPIC_API_KEY=

# Optional — Vercel Postgres connection string; without it, save-equation still returns 200 but skips DB insert
# POSTGRES_URL=

# Optional — proxy listen port (default 3001)
# PORT=3001

# Optional — API model IDs (defaults: gpt-5.4-mini, gpt-5.4-nano, claude-haiku-4-5)
# OPENAI_MODEL_CONCEPT=gpt-5.4-mini
# OPENAI_MODEL_EMOJI=gpt-5.4-nano
# ANTHROPIC_MODEL_CONCEPT=claude-haiku-4-5-20251001
